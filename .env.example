PORT=3000
WS_PATH=/realtime
DEFAULT_TASK_KEY=general_voice_assistant
TASK_CONFIG_PATH=data/tasks.local.json

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_REQUEST_TIMEOUT_MS=180000
OLLAMA_HEALTH_TIMEOUT_MS=10000
OLLAMA_NUM_PREDICT=120
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=30m
OLLAMA_THINK=false

VOICE_GATEWAY_HOST=0.0.0.0
VOICE_GATEWAY_PORT=8004
NEST_WS_URL=ws://127.0.0.1:3000/realtime

LOCAL_STT_MODEL=Systran/faster-distil-whisper-large-v3
LOCAL_STT_DEVICE=cpu
LOCAL_STT_COMPUTE_TYPE=int8
LOCAL_STT_LANGUAGE=en
LOCAL_STT_PRELOAD=true

LOCAL_TTS_DEVICE=auto
LOCAL_TTS_PRELOAD=true
LOCAL_TTS_WARMUP_TEXT=Ready.
LOCAL_TTS_SAMPLE_RATE=24000
LOCAL_CHATTERBOX_MODEL=ResembleAI/chatterbox-turbo
LOCAL_CHATTERBOX_AUDIO_PROMPT_PATH=
LOCAL_CHATTERBOX_EMOTION_TAGS=true
LOCAL_CHATTERBOX_TEMPERATURE=0.8
LOCAL_CHATTERBOX_TOP_P=0.95
LOCAL_CHATTERBOX_TOP_K=1000
LOCAL_CHATTERBOX_REPETITION_PENALTY=1.2
LOCAL_CHATTERBOX_EXAGGERATION=0.5
LOCAL_CHATTERBOX_NORM_LOUDNESS=true
LOCAL_CHATTERBOX_PROGRESS=false

VOICE_GATEWAY_TTS_ENABLED=true
VOICE_GATEWAY_GREETING_ENABLED=true
VOICE_GATEWAY_GREETING_TEXT="Hi, this is your AI voice assistant. How can I help you today?"
VOICE_CALL_END_AUDIO_TAIL_MS=650
VOICE_OUTPUT_DRAIN_POLL_MS=50
VOICE_OUTPUT_DRAIN_MAX_MS=30000

VOICE_TTS_MIN_PHRASE_CHARS=8
VOICE_TTS_FIRST_PHRASE_MAX_CHARS=95
VOICE_TTS_PHRASE_TARGET_CHARS=95
VOICE_TTS_PHRASE_MAX_CHARS=145
VOICE_TTS_MAX_SPOKEN_CHARS_PER_TURN=260
VOICE_TTS_TRIM_SILENCE=true
VOICE_TTS_TRIM_SILENCE_THRESHOLD=0.008
VOICE_TTS_TRIM_SILENCE_KEEP_MS=80

VOICE_VAD_MIN_SPEECH_THRESHOLD=0.025
VOICE_VAD_NOISE_MULTIPLIER=3.0
VOICE_VAD_SILENCE_MS=420
VOICE_VAD_MAX_UTTERANCE_MS=8000
VOICE_VAD_MIN_UTTERANCE_MS=320
VOICE_VAD_MIN_SPEECH_MS=240
VOICE_VAD_BARGE_MIN_SPEECH_MS=240
VOICE_VAD_BARGE_MIN_PEAK_LEVEL=0.055
VOICE_VAD_BARGE_THRESHOLD_MULTIPLIER=2.4
VOICE_VAD_BARGE_HOLD_MS=140
VOICE_VAD_BARGE_START_GRACE_MS=350
VOICE_VAD_PREROLL_MS=450

VOICE_TRANSCRIPT_COALESCING_ENABLED=true
VOICE_TRANSCRIPT_COMMIT_DELAY_MS=650
VOICE_TRANSCRIPT_STRUCTURED_COMMIT_DELAY_MS=1200
VOICE_TRANSCRIPT_INCOMPLETE_STRUCTURED_COMMIT_DELAY_MS=4000
VOICE_TRANSCRIPT_MAX_COALESCE_MS=12000
VOICE_TRANSCRIPT_MIN_FINAL_WORDS=5
VOICE_STT_QUEUE_MAX_SIZE=6
VOICE_GATEWAY_BLOCKING_PRELOAD=true

WEBRTC_ICE_SERVERS_JSON=
# Example:
# WEBRTC_ICE_SERVERS_JSON=[{"urls":["turn:turn.example.com:3478?transport=tcp"],"username":"voice","credential":"change-me"}]
WEBRTC_ICE_TRANSPORT_POLICY=all
WEBRTC_SERVER_USE_BROWSER_ICE=false
WEBRTC_SERVER_ICE_SERVERS_JSON=
WEBRTC_STUN_URLS=
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
